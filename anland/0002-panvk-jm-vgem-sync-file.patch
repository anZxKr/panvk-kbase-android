+static void
+jm_vgem_signal_now(int drm_fd, uint32_t fence)
+{
+   struct drm_vgem_fence_signal arg = {
+      .fence = fence,
+   };
+   if (drmIoctl(drm_fd, DRM_IOCTL_VGEM_FENCE_SIGNAL, &arg) < 0)
+      mesa_logw("vgem fence signal failed: %s", strerror(errno));
+}
+
+static const char *
+jm_vgem_node(void)
+{
+   const char *node = os_get_option("PANVK_KBASE_DRM_NODE");
+   return node && node[0] && strcmp(node, "0") ? node : "/dev/dri/renderD128";
+}
+
+static bool
+jm_vgem_is_render_node(int fd)
+{
+   struct stat st;
+   char name[sizeof("vgem") - 1];
+   struct drm_version version = {
+      .name_len = sizeof(name),
+      .name = name,
+   };
+
+   return fstat(fd, &st) == 0 && S_ISCHR(st.st_mode) &&
+          drmGetNodeTypeFromFd(fd) == DRM_NODE_RENDER &&
+          drmIoctl(fd, DRM_IOCTL_VERSION, &version) == 0 &&
+          version.name_len == sizeof(name) &&
+          !memcmp(name, "vgem", sizeof(name));
+}
+
+static VkResult
+jm_vgem_fd_wait_func(void *data, UNUSED const uint64_t *targets,
+                     uint64_t abs_timeout_ns)
+{
+   int fd = *(int *)data;
+   struct kbase_sync_file_waiter waiter = {
+      .fd = fd,
+   };
+   return kbase_sync_file_wait_func(&waiter, targets, abs_timeout_ns);
+}
+
+static void
+jm_vgem_job_finish(struct jm_vgem_signal_job *job)
+{
+   if (job->has_wait_fd && job->wait_fd >= 0)
+      close(job->wait_fd);
+   memset(job, 0, sizeof(*job));
+}
+
+static void
+jm_vgem_run_job(struct panvk_device *dev, struct jm_vgem_signal_job *job)
+{
+   VkResult result = VK_SUCCESS;
+
+   if (job->has_wait_fd)
+      job->data = &job->wait_fd;
+
+   if (job->wait)
+      result = job->wait(job->data, job->targets, job->timeout_ns);
+
+   if (result == VK_TIMEOUT)
+      vk_device_set_lost(&dev->vk, "vgem fence wait timed out");
+   else if (result != VK_SUCCESS)
+      vk_device_set_lost(&dev->vk, "vgem fence wait failed: %d", (int)result);
+
+   jm_vgem_signal_now(dev->jm_vgem.vgem_fd, job->fence);
+   jm_vgem_job_finish(job);
+}
+
+static int
+jm_vgem_worker_thread(void *arg)
+{
+   struct panvk_device *dev = arg;
+
+   mtx_lock(&dev->jm_vgem.mutex);
+   while (!dev->jm_vgem.stopping || dev->jm_vgem.queued) {
+      if (!dev->jm_vgem.queued) {
+         cnd_wait(&dev->jm_vgem.cond, &dev->jm_vgem.mutex);
+         continue;
+      }
+
+      struct jm_vgem_signal_job job =
+         dev->jm_vgem.jobs[dev->jm_vgem.head];
+      dev->jm_vgem.head =
+         (dev->jm_vgem.head + 1) % PANVK_JM_VGEM_WORKER_QUEUE_SIZE;
+      dev->jm_vgem.queued--;
+      mtx_unlock(&dev->jm_vgem.mutex);
+
+      jm_vgem_run_job(dev, &job);
+
+      mtx_lock(&dev->jm_vgem.mutex);
+   }
+   mtx_unlock(&dev->jm_vgem.mutex);
+   return 0;
+}
+
+void
+panvk_jm_vgem_worker_init(struct panvk_device *dev)
+{
+   const char *enabled = os_get_option("PANVK_KBASE_JM_VGEM_FENCE");
+   if (!enabled || enabled[0] != '1')
+      return;
+
+   const char *node = jm_vgem_node();
+   int fd = open(node, O_RDWR | O_CLOEXEC | O_NOCTTY);
+   if (fd < 0) {
+      mesa_logw("vgem fence: cannot open %s: %s", node, strerror(errno));
+      return;
+   }
+
+   if (!jm_vgem_is_render_node(fd)) {
+      mesa_logw("vgem fence: %s is not a vgem render node", node);
+      close(fd);
+      return;
+   }
+
+   if (mtx_init(&dev->jm_vgem.mutex, mtx_plain) != thrd_success) {
+      close(fd);
+      return;
+   }
+
+   if (cnd_init(&dev->jm_vgem.cond) != thrd_success) {
+      mtx_destroy(&dev->jm_vgem.mutex);
+      close(fd);
+      return;
+   }
+
+   dev->jm_vgem.vgem_fd = fd;
+   if (thrd_create(&dev->jm_vgem.thread, jm_vgem_worker_thread, dev) !=
+       thrd_success) {
+      mesa_logw("vgem fence: worker create failed");
+      dev->jm_vgem.vgem_fd = -1;
+      cnd_destroy(&dev->jm_vgem.cond);
+      mtx_destroy(&dev->jm_vgem.mutex);
+      close(fd);
+      return;
+   }
+
+   dev->jm_vgem.started = true;
+}
+
+void
+panvk_jm_vgem_worker_finish(struct panvk_device *dev)
+{
+   if (!dev->jm_vgem.started)
+      return;
+
+   mtx_lock(&dev->jm_vgem.mutex);
+   dev->jm_vgem.stopping = true;
+   cnd_broadcast(&dev->jm_vgem.cond);
+   mtx_unlock(&dev->jm_vgem.mutex);
+
+   thrd_join(dev->jm_vgem.thread, NULL);
+
+   int fd = dev->jm_vgem.vgem_fd;
+   cnd_destroy(&dev->jm_vgem.cond);
+   mtx_destroy(&dev->jm_vgem.mutex);
+   memset(&dev->jm_vgem, 0, sizeof(dev->jm_vgem));
+   if (fd >= 0)
+      close(fd);
+}
+
+static VkResult
+kbase_cpu_sync_export_sync_file_jm_vgem(struct vk_device *device,
+                                        struct vk_sync *sync,
+                                        int *sync_file)
+{
+   struct panvk_device *dev = to_panvk_device(device);
+   struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
+
+   if (!dev->jm_vgem.started)
+      return kbase_cpu_sync_export_sync_file_jm(device, sync, sync_file);
+
+   struct drm_vgem_fence_export_sync_file export = {0};
+   mtx_lock(&dev->jm_vgem.mutex);
+   int ret = drmIoctl(dev->jm_vgem.vgem_fd,
+                      DRM_IOCTL_VGEM_FENCE_EXPORT_SYNC_FILE, &export);
+   mtx_unlock(&dev->jm_vgem.mutex);
+   if (ret < 0 || export.fd < 0) {
+      mesa_logw("vgem fence export failed: %s", strerror(errno));
+      return kbase_cpu_sync_export_sync_file_jm(device, sync, sync_file);
+   }
+
+   struct jm_vgem_signal_job job = {
+      .dev = dev,
+      .fence = export.out_fence,
+      .timeout_ns = os_time_get_nano() + 25000000000ULL,
+   };
+
+   mtx_lock(&ks->mutex);
+   if (ks->state != KBASE_CPU_SYNC_SIGNALED) {
+      job.wait = ks->pending_wait;
+      job.data = ks->pending_data;
+      memcpy(job.targets, ks->targets, sizeof(job.targets));
+
+      if (job.wait == kbase_sync_file_wait_func && job.data) {
+         struct kbase_sync_file_waiter *src = job.data;
+         int fd = src->fd >= 0 ? dup(src->fd) : -1;
+         if (fd < 0) {
+            job.wait = NULL;
+            job.data = NULL;
+         } else {
+            job.wait = jm_vgem_fd_wait_func;
+            job.wait_fd = fd;
+            job.has_wait_fd = true;
+            job.data = NULL;
+         }
+      }
+   }
+   mtx_unlock(&ks->mutex);
+
+   mtx_lock(&dev->jm_vgem.mutex);
+   if (!dev->jm_vgem.stopping &&
+       dev->jm_vgem.queued < PANVK_JM_VGEM_WORKER_QUEUE_SIZE) {
+      uint32_t tail = dev->jm_vgem.tail;
+      dev->jm_vgem.jobs[tail] = job;
+      dev->jm_vgem.tail =
+         (tail + 1) % PANVK_JM_VGEM_WORKER_QUEUE_SIZE;
+      dev->jm_vgem.queued++;
+      cnd_signal(&dev->jm_vgem.cond);
+      mtx_unlock(&dev->jm_vgem.mutex);
+   } else {
+      mtx_unlock(&dev->jm_vgem.mutex);
+      jm_vgem_run_job(dev, &job);
+   }
+
+   *sync_file = export.fd;
+   return VK_SUCCESS;
+}
