+#define DRM_VGEM_FENCE_EXPORT_SYNC_FILE 0x3
+#define DRM_VGEM_FENCE_SIGNAL 0x2
+
+struct drm_vgem_fence_export_sync_file {
+   uint32_t flags;
+   uint32_t out_fence;
+   int32_t fd;
+   uint32_t pad;
+};
+
+struct drm_vgem_fence_signal {
+   uint32_t fence;
+   uint32_t flags;
+};
+
+#define DRM_IOCTL_VGEM_FENCE_EXPORT_SYNC_FILE                                   \
+   DRM_IOWR(DRM_COMMAND_BASE + DRM_VGEM_FENCE_EXPORT_SYNC_FILE,                 \
+            struct drm_vgem_fence_export_sync_file)
+#define DRM_IOCTL_VGEM_FENCE_SIGNAL                                             \
+   DRM_IOW(DRM_COMMAND_BASE + DRM_VGEM_FENCE_SIGNAL,                            \
+           struct drm_vgem_fence_signal)
+#endif
