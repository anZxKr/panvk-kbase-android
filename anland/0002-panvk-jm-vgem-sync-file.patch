 #include "genxml/gen_macros.h"
 
 #define PER_ARCH_FUNCS(_ver)                                                   \
@@ -1241,6 +1265,120 @@ kbase_cpu_sync_export_sync_file_jm(struct vk_device *device,
    return VK_SUCCESS;
 }
 
+struct jm_vgem_signal_job {
+   int drm_fd;
+   uint32_t fence;
+   panvk_kbase_sync_wait_func wait;
+   void *data;
+   uint64_t targets[PANVK_KBASE_SYNC_TARGET_COUNT];
+   uint64_t timeout_ns;
+};
+
+static void
+jm_vgem_signal_now(int drm_fd, uint32_t fence)
+{
+   struct drm_vgem_fence_signal arg = {
+      .fence = fence,
+   };
+   drmIoctl(drm_fd, DRM_IOCTL_VGEM_FENCE_SIGNAL, &arg);
+}
+
+static int
+jm_vgem_signal_thread(void *arg)
+{
+   struct jm_vgem_signal_job *job = arg;
+
+   if (job->wait)
+      job->wait(job->data, job->targets, job->timeout_ns);
+
+   jm_vgem_signal_now(job->drm_fd, job->fence);
+
+   if (job->data && job->wait == kbase_sync_file_wait_func) {
+      struct kbase_sync_file_waiter *waiter = job->data;
+      if (waiter->fd >= 0)
+         close(waiter->fd);
+      free(waiter);
+   }
+
+   close(job->drm_fd);
+   free(job);
+   return 0;
+}
+
+static VkResult
+kbase_cpu_sync_export_sync_file_jm_vgem(struct vk_device *device,
+                                        struct vk_sync *sync,
+                                        int *sync_file)
+{
+   const char *enabled = os_get_option("PANVK_KBASE_JM_VGEM_FENCE");
+   if (!enabled || enabled[0] != '1')
+      return kbase_cpu_sync_export_sync_file_jm(device, sync, sync_file);
+
+   const char *node = os_get_option("PANVK_KBASE_DRM_NODE");
+   if (!node || !node[0] || !strcmp(node, "0"))
+      node = "/dev/dri/renderD128";
+
+   int vgem_fd = open(node, O_RDWR | O_CLOEXEC | O_NOCTTY);
+   if (vgem_fd < 0)
+      return kbase_cpu_sync_export_sync_file_jm(device, sync, sync_file);
+
+   struct drm_vgem_fence_export_sync_file export = {0};
+   if (drmIoctl(vgem_fd, DRM_IOCTL_VGEM_FENCE_EXPORT_SYNC_FILE, &export) < 0 ||
+       export.fd < 0) {
+      close(vgem_fd);
+      return kbase_cpu_sync_export_sync_file_jm(device, sync, sync_file);
+   }
+
+   struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
+   struct jm_vgem_signal_job *job = calloc(1, sizeof(*job));
+   if (!job) {
+      jm_vgem_signal_now(vgem_fd, export.out_fence);
+      close(export.fd);
+      close(vgem_fd);
+      return kbase_cpu_sync_export_sync_file_jm(device, sync, sync_file);
+   }
+
+   job->drm_fd = vgem_fd;
+   job->fence = export.out_fence;
+   job->timeout_ns = os_time_get_nano() + 25000000000ULL;
+
+   mtx_lock(&ks->mutex);
+   if (ks->state != KBASE_CPU_SYNC_SIGNALED) {
+      job->wait = ks->pending_wait;
+      job->data = ks->pending_data;
+      memcpy(job->targets, ks->targets, sizeof(job->targets));
+   }
+   mtx_unlock(&ks->mutex);
+
+   if (job->wait == kbase_sync_file_wait_func && job->data) {
+      struct kbase_sync_file_waiter *src = job->data;
+      struct kbase_sync_file_waiter *copy = malloc(sizeof(*copy));
+      if (!copy || src->fd < 0 || (copy->fd = dup(src->fd)) < 0) {
+         free(copy);
+         job->wait = NULL;
+         job->data = NULL;
+      } else {
+         job->data = copy;
+      }
+   }
+
+   if (job->wait) {
+      thrd_t thread;
+      if (thrd_create(&thread, jm_vgem_signal_thread, job) != thrd_success) {
+         job->wait = NULL;
+         jm_vgem_signal_thread(job);
+         close(export.fd);
+         return kbase_cpu_sync_export_sync_file_jm(device, sync, sync_file);
+      }
+      thrd_detach(thread);
+   } else {
+      jm_vgem_signal_thread(job);
+   }
+
+   *sync_file = export.fd;
+   return VK_SUCCESS;
+}
