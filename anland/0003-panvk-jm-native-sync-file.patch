+static uint64_t
+kbase_jm_soft_submit(struct pan_kmod_dev *dev, uint32_t core_req,
+                     uintptr_t jc, uint64_t dep0, uint64_t dep1)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (kd->is_csf) {
+      errno = ENOTSUP;
+      return 0;
+   }
+
+   struct kbase_atom_slot *slot =
+      kbase_atom_alloc(kd, NULL, 0, core_req, true);
+   if (!slot)
+      return 0;
+
+   struct base_jd_atom atom = {
+      .jc = (uint64_t)jc,
+      .core_req = core_req,
+      .atom_number = (uint8_t)slot->atom_number,
+   };
+   uint64_t deps[2] = { dep0, dep1 };
+   for (unsigned i = 0; i < 2; i++) {
+      bool use = deps[i] && deps[i] != atom.atom_number;
+      atom.pre_dep[i].atom_id = use ? (uint8_t)deps[i] : 0;
+      atom.pre_dep[i].dependency_type = use ? BASE_JD_DEP_TYPE_DATA : 0;
+   }
+
+   struct {
+      __u64 seq_nr;
+      struct base_jd_atom atom;
+   } w = { .atom = atom };
+   struct kbase_ioctl_job_submit sub = {
+      .addr = kd->atom_seq_nr ? (uintptr_t)&w : (uintptr_t)&atom,
+      .nr_atoms = 1,
+      .stride = kd->atom_stride,
+   };
+   if (ioctl(dev->fd, KBASE_IOCTL_JOB_SUBMIT, &sub) < 0) {
+      mesa_loge("kbase: JOB_SUBMIT(soft fence) failed: %s", strerror(errno));
+      simple_mtx_lock(&kd->atoms_lock);
+      slot->atom_number = 0;
+      simple_mtx_unlock(&kd->atoms_lock);
+      return 0;
+   }
+   return atom.atom_number;
+}
+
+static uint64_t
+kbase_jm_fence_trigger(struct pan_kmod_dev *dev, uint64_t dep0, uint64_t dep1,
+                       int *out_fd)
+{
+   struct base_fence fence = {
+      .basep = {
+         .fd = -1,
+         .stream_fd = -1,
+      },
+   };
+   uint64_t atom = kbase_jm_soft_submit(dev, BASE_JD_REQ_SOFT_FENCE_TRIGGER,
+                                        (uintptr_t)&fence, dep0, dep1);
+   if (!atom)
+      return 0;
+   if (fence.basep.fd < 0) {
+      errno = ENODEV;
+      return 0;
+   }
+   *out_fd = fence.basep.fd;
+   return atom;
+}
+
+int
+kbase_kmod_jm_fence_wait(struct pan_kmod_dev *dev, int fd)
+{
+   struct base_fence fence = {
+      .basep = {
+         .fd = fd,
+         .stream_fd = -1,
+      },
+   };
+   uint64_t atom = kbase_jm_soft_submit(dev, BASE_JD_REQ_SOFT_FENCE_WAIT,
+                                        (uintptr_t)&fence, 0, 0);
+   if (!atom)
+      return errno ? -errno : -EINVAL;
+   return (int)atom;
+}
+
+int
+kbase_kmod_jm_fence_export(struct pan_kmod_dev *dev,
+                           const uint64_t deps[KBASE_KMOD_JM_FENCE_MAX_DEPS],
+                           int *out_fd)
+{
+   uint64_t chain[KBASE_KMOD_JM_FENCE_MAX_DEPS] = { 0 };
+   unsigned n = 0;
+
+   for (unsigned i = 0; i < KBASE_KMOD_JM_FENCE_MAX_DEPS; i++) {
+      if (!deps[i])
+         continue;
+      if (n == ARRAY_SIZE(chain)) {
+         errno = EINVAL;
+         return -EINVAL;
+      }
+      chain[n++] = deps[i];
+   }
+
+   while (n > 2) {
+      int tmp_fd = -1;
+      uint64_t atom = kbase_jm_fence_trigger(dev, chain[0], chain[1], &tmp_fd);
+      if (!atom)
+         return errno ? -errno : -EINVAL;
+      close(tmp_fd);
+
+      unsigned remaining = n - 2;
+      memmove(chain, chain + 2, remaining * sizeof(chain[0]));
+      chain[remaining] = atom;
+      n = remaining + 1;
+   }
+
+   int fd = -1;
+   uint64_t atom = kbase_jm_fence_trigger(dev, n > 0 ? chain[0] : 0,
+                                          n > 1 ? chain[1] : 0, &fd);
+   if (!atom)
+      return errno ? -errno : -EINVAL;
+   *out_fd = fd;
+   return 0;
+}
