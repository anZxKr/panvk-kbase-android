+static VkResult
+kbase_cpu_sync_export_sync_file_jm_native(struct vk_device *device,
+                                          struct vk_sync *sync,
+                                          int *sync_file)
+{
+   struct panvk_device *dev = to_panvk_device(device);
+   struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
+   uint64_t deps[KBASE_KMOD_JM_FENCE_MAX_DEPS] = { 0 };
+   unsigned n = 0;
+   int wait_fd = -1;
+   bool supported = false;
+
+   mtx_lock(&ks->mutex);
+   if (ks->state == KBASE_CPU_SYNC_SIGNALED) {
+      supported = true;
+   } else if (ks->state == KBASE_CPU_SYNC_FAILED) {
+      VkResult result = ks->result;
+      mtx_unlock(&ks->mutex);
+      return result;
+   } else {
+      for (unsigned i = 0; i < PANVK_KBASE_SYNC_TARGET_COUNT; i++) {
+         if (!ks->targets[i])
+            continue;
+         if (n >= ARRAY_SIZE(deps))
+            break;
+         deps[n++] = ks->targets[i];
+      }
+
+      if (ks->pending_wait == kbase_sync_file_wait_func && ks->pending_data) {
+         struct kbase_sync_file_waiter *waiter = ks->pending_data;
+         if (waiter->fd >= 0)
+            wait_fd = dup(waiter->fd);
+      }
+
+      supported = ks->pending_wait == kbase_sync_file_wait_func ? wait_fd >= 0 : ks->state != KBASE_CPU_SYNC_RESET;
+   }
+   mtx_unlock(&ks->mutex);
+
+   if (!supported) {
+      if (wait_fd >= 0)
+         close(wait_fd);
+      return vk_errorf(device, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "native fence export has no atom or sync_file payload");
+   }
+
+   if (wait_fd >= 0) {
+      int atom = kbase_kmod_jm_fence_wait(dev->kmod.dev, wait_fd);
+      close(wait_fd);
+      if (atom < 0)
+         return vk_errorf(device, VK_ERROR_DEVICE_LOST,
+                          "native fence wait submit failed: %s",
+                          strerror(-atom));
+      if (n >= ARRAY_SIZE(deps))
+         return vk_errorf(device, VK_ERROR_FEATURE_NOT_PRESENT,
+                          "native fence dependency overflow");
+      deps[n++] = atom;
+   }
