+   int ret = kbase_kmod_jm_fence_export(dev->kmod.dev, deps, &fd);
+   if (ret < 0)
+      return vk_errorf(device, VK_ERROR_DEVICE_LOST,
+                       "native fence export failed: %s", strerror(-ret));
+
+   *sync_file = fd;
+   return VK_SUCCESS;
+}
