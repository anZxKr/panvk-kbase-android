+/*
+ * JM/kbase has no CQS/KCPU queue to export a GPU fence from, and this kernel
+ * (4.19) provides neither /dev/sw_sync nor drm syncobj on the render node.
+ * Wait for the CPU-side sync to retire, then hand out an already-signalled
+ * eventfd.  This keeps Zink's PIPE_FLUSH_FENCE_FD path alive on Bifrost;
+ * cross-process GPU synchronisation is effectively disabled (the Anland
+ * socketpair still carries render-done), so tearing is possible.
+ */
+static VkResult
+kbase_cpu_sync_export_sync_file_jm(struct vk_device *device,
+                                   struct vk_sync *sync,
+                                   int *sync_file)
+{
+   struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
+
+   if (ks) {
+      VkResult result = kbase_cpu_sync_wait_one(device, ks, VK_SYNC_WAIT_COMPLETE,
+                                                os_time_get_nano() + 2000000000ULL);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   /* Prefer a real Android sync_file we imported earlier; the consumer's
+    * Vulkan SYNC_FD import will accept it.  Fall back to an eventfd. */
+   int stash = __atomic_load_n(&jm_signal_sync_fd, __ATOMIC_RELAXED);
+   if (stash >= 0) {
+      int out = dup(stash);
+      if (out >= 0) {
+         *sync_file = out;
+         return VK_SUCCESS;
+      }
+   }
+
+   int fd = eventfd(1, EFD_CLOEXEC);
+   if (fd < 0)
+      return vk_errorf(device, VK_ERROR_OUT_OF_HOST_MEMORY,
+                       "eventfd failed: %m");
+
+   *sync_file = fd;
+   return VK_SUCCESS;
+}
+
