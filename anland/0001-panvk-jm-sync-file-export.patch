+/* JM/kbase fence-export workaround: on this kernel there is no /dev/sw_sync,
+ * no drm syncobj on vgem, and no kbase JM sync_file export.  The Android
+ * consumer hands us real SYNC_FD release fences which we dup on import; keep
+ * one of those so we can hand a *valid* (already-signalled) sync_file back on
+ * export.  An eventfd would be rejected by the consumer's Vulkan import.
+ */
+static int jm_signal_sync_fd = -1;
+
+static void
+jm_stash_sync_fd(int fd)
+{
+   int cur = __atomic_load_n(&jm_signal_sync_fd, __ATOMIC_RELAXED);
+   if (cur >= 0)
+      return;
+   int staged = dup(fd);
+   if (staged < 0)
+      return;
+   if (!__atomic_compare_exchange_n(&jm_signal_sync_fd, &cur, staged,
+                                    false, __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+      close(staged);
+}
